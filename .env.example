# Copy this file to .env (same folder) and change the values.
# .env is ignored by git, so your passwords never get committed.

# MySQL (used by docker-compose and by the backend)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=expense_tracker
DB_USERNAME=expense_app
DB_PASSWORD=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password

# Signs login tokens. Use a long random string (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# How long a login lasts, in minutes (1440 = 1 day)
JWT_EXPIRATION_MINUTES=1440
